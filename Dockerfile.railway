# Railway 전용 slim Dockerfile (Plan v0.3 Phase 2.3 fix, 2026-05-17)
#
# Why not upstream Dockerfile?
#   Upstream uses BuildKit syntax that Railway Metal builder rejects:
#     - type=bind mount (other mount types are not supported on Railway)
#     - cache mount id missing required `s/<service-id>-` prefix
#   Reference: Railway docs §Dockerfiles "Railway supports Docker cache mounts using format
#              --mount=type=cache,id=s/<service id>-<target path>"
#
# Approach:
#   npm package openclaw@2026.5.12 includes telegram extension (package.json files §"!dist/extensions"
#   pattern excludes only discord/whatsapp/lobster — telegram NOT excluded).
#   Avoids BuildKit cache mount entirely.
#
# Upstream Dockerfile is preserved untouched for upstream sync compatibility.
# Switch back to upstream Dockerfile by setting railway.json dockerfilePath: "Dockerfile".

FROM node:24-bookworm-slim

WORKDIR /app

# ca-certificates: HTTPS to OpenRouter/Telegram/Anthropic APIs
# curl: healthcheck debugging + Pretendard font download at build time
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Sharp uses prebuilt binaries — skip global libvips probe
# Reference: openclaw AGENTS.md §Commands "SHARP_IGNORE_GLOBAL_LIBVIPS=1 pnpm install"
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=1

# Global install pinned version
# Reference: README §"Install (recommended)" — `npm install -g openclaw@latest`
RUN npm install -g openclaw@2026.5.12

# PDF generation toolchain (2026-05-18 — MEDIA: .txt 실패 RCA after Telegram 'Media failed')
# Why pdfkit: pure JS (no Chromium), 5MB, Korean font embed 지원.
# Install in /opt/scripts so require() resolves via local node_modules.
RUN mkdir -p /opt/scripts && cd /opt/scripts && npm install pdfkit@0.15 --no-audit --no-fund

# Pretendard Korean font (OFL — https://github.com/orioncactus/pretendard)
# Build-time download to avoid bloating git repo with font binaries.
# Regular: ~700KB, Bold: ~750KB.
RUN mkdir -p /opt/fonts && \
    curl -fsSL -o /opt/fonts/Pretendard-Regular.otf \
      https://github.com/orioncactus/pretendard/raw/main/packages/pretendard/dist/public/static/Pretendard-Regular.otf && \
    curl -fsSL -o /opt/fonts/Pretendard-Bold.otf \
      https://github.com/orioncactus/pretendard/raw/main/packages/pretendard/dist/public/static/Pretendard-Bold.otf

# PDF generation script (used by bot via exec when 김팀장 needs to send .pdf)
COPY tools/scripts/gen-pdf.js /opt/scripts/gen-pdf.js
RUN chmod +x /opt/scripts/gen-pdf.js

ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=2048

EXPOSE 8080

# Entrypoint: generate openclaw.json from env vars on every boot
# Plan v0.3 Phase 3.2 — avoids manual file editing in volume (Railway has no file browser)
COPY entrypoint.sh /usr/local/bin/openclaw-entrypoint.sh
RUN chmod +x /usr/local/bin/openclaw-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/openclaw-entrypoint.sh"]

# CMD passed as arguments to entrypoint (exec "$@")
# Reference: fly.toml L624 `--allow-unconfigured --port 3000 --bind lan` pattern
CMD ["openclaw", "gateway", "--allow-unconfigured", "--port", "8080", "--bind", "lan"]
